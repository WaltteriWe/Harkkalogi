# PostgreSQL Configuration
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_PORT=55432

# Prisma Database URL
DATABASE_URL=postgresql://myuser:mypassword@localhost:55432/mydb?schema=public

# Node.js API
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# MinIO / S3-compatible profile image storage
MINIO_ROOT_USER=replace-with-a-unique-username
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=harkkalogi-profile-images
S3_ACCESS_KEY=replace-with-the-same-value-as-MINIO_ROOT_USER
S3_SECRET_KEY=replace-with-the-same-value-as-MINIO_ROOT_PASSWORD
