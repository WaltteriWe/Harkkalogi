# ==============================================================================
# Harkkalogi Backend & Database Environment Configuration
# Copy this file to `backend/.env` for local development:
#   cp backend/.env.example backend/.env
# Note: The root `.env` is a symlink pointing to `backend/.env` for docker-compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Port the Express server listens on
PORT=4000

# Application environment: development | production | test
NODE_ENV=development

# Allowed CORS origin (URL of the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Used by docker-compose.yml)
# ------------------------------------------------------------------------------
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
# Host port mapping for PostgreSQL (change if 5432 is in use locally, e.g. 5433)
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Prisma ORM Connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb?schema=public

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to cryptographically sign and verify JWT tokens.
# IN PRODUCTION: Must be a random, high-entropy string (min 32 characters).
JWT_SECRET=super-secret-jwt-key-for-development-harkkalogi

# Token expiration duration (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d
