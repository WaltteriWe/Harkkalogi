// Prisma schema for the internship reporting prototype (PostgreSQL).
// Keep the generator block that `npx prisma init` created if it differs from this one.
// The connection URL lives in prisma.config.ts / .env, not here.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum StudyType {
  DAYTIME
  MULTIFORM
}

enum InternshipStatus {
  ONGOING
  COMPLETED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum ReviewDecision {
  APPROVED
  NEEDS_CHANGES
}

enum PlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_CHANGES
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  studyType    StudyType? // DAYTIME or MULTIFORM (applicable when role == STUDENT)
  createdAt    DateTime   @default(now())

  // Student side
  internships Internship[] @relation("StudentInternships")
  plans       Plan[]       @relation("StudentPlans")

  // Teacher side
  supervised Internship[] @relation("TeacherInternships")
  reviews    Review[]

  // Messaging relations
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Internship {
  id            Int              @id @default(autoincrement())
  title         String           @default("Harjoittelu 1")
  order         Int              @default(1)
  credits       Int              @default(15)
  requiredHours Int              @default(400)
  company       String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  status        InternshipStatus @default(ONGOING)

  studentId Int
  student   User @relation("StudentInternships", fields: [studentId], references: [id])

  teacherId Int?
  teacher   User? @relation("TeacherInternships", fields: [teacherId], references: [id])

  reports            Report[]
  messages           Message[]
  plan               Plan?
  guidanceEvaluation GuidanceEvaluation?

  @@index([studentId])
  @@index([teacherId])
}

model Report {
  id          Int          @id @default(autoincrement())
  title       String
  content     String
  status      ReportStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  internshipId Int
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  reviews Review[]

  @@index([internshipId])
  @@index([status])
}

model Review {
  id        Int            @id @default(autoincrement())
  comment   String
  decision  ReviewDecision
  createdAt DateTime       @default(now())

  reportId Int
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  teacherId Int
  teacher   User @relation(fields: [teacherId], references: [id])

  @@index([reportId])
  @@index([teacherId])
}

model Message {
  id        Int      @id @default(autoincrement())
  subject   String?  // Thread subject (optional on thread replies)
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sender (User)
  senderId Int
  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Recipient (User)
  recipientId Int?
  recipient   User? @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)

  // Contextual link to an internship
  internshipId Int?
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: SetNull)

  // Threading: Parent message and thread replies
  parentId Int?
  parent   Message?  @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("ThreadReplies")

  // File attachments
  attachments MessageAttachment[]

  @@index([senderId])
  @@index([recipientId])
  @@index([internshipId])
  @@index([parentId])
  @@index([read])
}

model MessageAttachment {
  id        Int      @id @default(autoincrement())
  name      String   // File display name (e.g. Harjoittelusopimus_hyvaksytty.pdf)
  size      String?  // Formatted file size (e.g. "1.2 MB")
  fileUrl   String   // Storage location or download URL
  mimeType  String?
  createdAt DateTime @default(now())

  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Plan {
  id                Int        @id @default(autoincrement())
  scope             String     @default("h1")
  company           String
  jobTitle          String?
  supervisorName    String?
  supervisorContact String?
  startDate         DateTime?
  endDate           DateTime?
  plannedHours      Int?       @default(400)
  hoursPerWeek      Float?
  jobDescription    String?    @db.Text
  learningGoals     Json?
  assessment        String?    @db.Text
  status            PlanStatus @default(DRAFT)
  submittedAt       DateTime?
  approvedAt        DateTime?
  teacherFeedback   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  studentId         Int
  student           User       @relation("StudentPlans", fields: [studentId], references: [id], onDelete: Cascade)

  internshipId      Int?       @unique
  internship        Internship? @relation(fields: [internshipId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model GuidanceEvaluation {
  id           Int        @id @default(autoincrement())
  internshipId Int        @unique
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId    Int
  status       String     @default("DRAFT")
  checklist    Json?
  ratings      Json?
  feedback     String?    @db.Text
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([studentId])
}
